[Unit]
Description=Forgejo Actions Runner
Documentation=https://forgejo.org/docs/latest/admin/actions/
After=network-online.target forgejo.service
Wants=network-online.target
PartOf=forgejo.service
# Stay inactive until the runner has been registered (writes .runner).
ConditionFileNotEmpty=/var/lib/forgejo-runner/.runner

[Service]
Type=simple
User=forgejo
Group=forgejo

Environment=USER=forgejo
Environment=HOME=/var/lib/forgejo-runner
Environment=XDG_RUNTIME_DIR=/run/forgejo
WorkingDirectory=/var/lib/forgejo-runner

# Register first (as the forgejo user, from this working directory):
#   sudo -u forgejo -H forgejo-runner register \
#        --config /etc/forgejo/runner/config.yml \
#        --instance https://git.example.com \
#        --token <REGISTRATION_TOKEN> \
#        --name "$(hostname)" --labels docker:docker://node:20-bookworm
ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo/runner/config.yml
Restart=on-failure
RestartSec=5s

# --- Hardening -------------------------------------------------------------
# NOTE: the runner executes jobs and spawns containers. Very strict sandboxing
# breaks rootless Podman/Docker-in-Docker, so this is intentionally lighter
# than the server unit. Tighten/loosen to match your container backend.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

StateDirectory=forgejo-runner
ReadWritePaths=/var/lib/forgejo-runner /run/forgejo
ReadOnlyPaths=/etc/forgejo

# --- Container backend options --------------------------------------------
# Option A: use a system Docker daemon via its socket (adds to docker group).
#   SupplementaryGroups=docker
#   ReadWritePaths=/var/run/docker.sock
#
# Option B: rootless Podman run entirely as the forgejo user (preferred, keeps
# the "individual forgejo user/group" isolation). Requires a subuid/subgid
# range for forgejo and XDG_RUNTIME_DIR to be writable:
#   (nothing extra here; see /etc/subuid and /etc/subgid)

[Install]
WantedBy=multi-user.target
